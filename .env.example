# SECDEF — Environment Configuration Template
APP_NAME="SECDEF"
APP_ENV=development
LOG_LEVEL=INFO

# Control Plane Database
DATABASE_URL="sqlite+aiosqlite:///./asm_dev.db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"

# Security (MUST BE CHANGED IN PRODUCTION)
SECRET_KEY="CHANGE_THIS_IN_PRODUCTION_TO_A_32BYTE_RANDOM_STRING_KEY"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1"]

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
